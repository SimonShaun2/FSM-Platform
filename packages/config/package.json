{
  "name": "@fsm/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/env.js",
  "types": "./dist/env.d.ts",
  "exports": {
    ".": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./feature-flags": {
      "types": "./dist/feature-flags.d.ts",
      "import": "./dist/feature-flags.js"
    },
    "./object-storage": {
      "types": "./dist/object-storage/index.d.ts",
      "import": "./dist/object-storage/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.931.0",
    "@aws-sdk/s3-request-presigner": "3.1038.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
