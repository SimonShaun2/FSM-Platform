{
  "name": "@fsm/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/env.js",
  "types": "./dist/env.d.ts",
  "exports": {
    ".": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./feature-flags": {
      "types": "./dist/feature-flags.d.ts",
      "import": "./dist/feature-flags.js"
    },
    "./import-vendor-presets": {
      "types": "./dist/import-vendor-presets.d.ts",
      "import": "./dist/import-vendor-presets.js"
    },
    "./import-source-presets": {
      "types": "./dist/import-source-presets.d.ts",
      "import": "./dist/import-source-presets.js"
    },
    "./import-price-book-map": {
      "types": "./dist/import-price-book-map.d.ts",
      "import": "./dist/import-price-book-map.js"
    },
    "./import-bundle-storage": {
      "types": "./dist/import-bundle-storage.d.ts",
      "import": "./dist/import-bundle-storage.js"
    },
    "./object-storage": {
      "types": "./dist/object-storage/index.d.ts",
      "import": "./dist/object-storage/index.js"
    },
    "./deployment-environment": {
      "types": "./dist/deployment-environment.d.ts",
      "import": "./dist/deployment-environment.js"
    },
    "./neon-ci": {
      "types": "./dist/neon-ci.d.ts",
      "import": "./dist/neon-ci.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fsm/import-normalize": "workspace:*",
    "@aws-sdk/client-s3": "^3.931.0",
    "@aws-sdk/s3-request-presigner": "3.1038.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
